{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=AgileEstimationDb;Integrated Security=True;"
  },

  "Jwt": {
    "Key": "REPLACE_ME_via_Jwt__Key_env_var_or_dotnet_user-secrets",
    "Issuer": "AgileEstimationAPI",
    "Audience": "AgileEstimationClient",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
